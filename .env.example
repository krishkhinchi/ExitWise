# Exitwise Environment Configuration
# Track 1: Gemma 4 Dependency Resilience

# Google Gemini API key (for hosted Gemma 4 models)
# Either GEMINI_API_KEY or GOOGLE_API_KEY can be used
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Gemma 4 Model ID on hosted Gemini API
# Supported models: gemma-4-26b-a4b-it, gemma-4-31b-it, gemma-4-12b-it
EXITWISE_MODEL=gemma-4-26b-a4b-it

# Optional GitHub Token for extended rate limits when querying repo health
# GITHUB_TOKEN=your_github_token_here

# Offline mode flag (set to 1 to skip external API calls)
# EXITWISE_OFFLINE=0
